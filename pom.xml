<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
        <!-- lookup parent from repository -->
        <!--
			Alpha：内测版，BUG多，开发人员开发过程中使用，希腊字母α，第一，指最初版
			Beta：早期版本，有缺陷，没有严重BUG，可能加入新功能，进一步开发完善
			Gamma: 经Beta 版，完善修改，成为正式发布的候选版本（Release Candidate）
			RC：(Release Candidate)：候选版本，几乎就是正式版了
			GA：（Ggeneral Availability）：发行稳定版，官方推荐使用此版本
			R，RELEASE：正式版，等价于GA
		-->
    </parent>
    <groupId>org.lambda.framework</groupId>
    <artifactId>lambda-framework</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>lambda-framework</name>
    <description>lambda framework</description>
    <url>https://github.com/MrWangGang</url>
    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>&#x738B;&#x521A;</name>
            <email>userbean@outlook.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git@github.com/MrWangGang/lambda-framework.git</connection>
        <developerConnection>scm:git:git@github.com/MrWangGang/lambda-framework.git</developerConnection>
        <url>git@github.com/MrWangGang/lambda-framework.git</url>
    </scm>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>27</java.version>
        <maven.compiler.release>27</maven.compiler.release>
        <maven.deploy.skip>true</maven.deploy.skip>
        <spring-cloud.version>2025.1.4</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <nacos-client.version>3.3.0</nacos-client.version>
        <fory.version>1.7.7</fory.version>
        <openai-service.version>0.18.2</openai-service.version>
        <guava.version>33.8.0-jre</guava.version>
        <jtokkit.version>1.1.0</jtokkit.version>
        <commons-lang3.version>3.21.0</commons-lang3.version>
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <jackson-datatype-jsr310.version>2.22.4</jackson-datatype-jsr310.version>
        <lombok.version>1.18.48</lombok.version>
        <redisson.version>4.8.0</redisson.version>
        <curator.version>5.9.0</curator.version>
        <rabbitmq.version>1.5.6</rabbitmq.version>
        <jnanoid.version>2.0.0</jnanoid.version>
        <modelmapper.version>3.2.8</modelmapper.version>
        <hutool-core.version>5.8.48</hutool-core.version>
        <reactor-kafka.version>1.3.25</reactor-kafka.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.fory</groupId>
                <artifactId>fory-core</artifactId>
                <version>${fory.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.nacos</groupId>
                <artifactId>nacos-client</artifactId>
                <version>${nacos-client.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.modelmapper</groupId>
                <artifactId>modelmapper</artifactId>
                <version>${modelmapper.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>commons-beanutils</groupId>
                <artifactId>commons-beanutils</artifactId>
                <version>${commons-beanutils.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-enum</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-guid</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-rpc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-rsocket</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-nacos</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-loadbalance</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-repository</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-qdrant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-httpclient</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-compliance</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-lock</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.lambda.framework</groupId>
                <artifactId>lambda-framework-mq</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.theokanning.openai-gpt3-java</groupId>
                <artifactId>service</artifactId>
                <version>${openai-service.version}</version>
            </dependency>
            <dependency>
                <groupId>com.knuddels</groupId>
                <artifactId>jtokkit</artifactId>
                <version>${jtokkit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson-datatype-jsr310.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-core</artifactId>
                <version>${hutool-core.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.curator</groupId>
                <artifactId>curator-recipes</artifactId>
                <version>${curator.version}</version>
            </dependency>
            <dependency>
                <groupId>io.projectreactor.rabbitmq</groupId>
                <artifactId>reactor-rabbitmq</artifactId>
                <version>${rabbitmq.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aventrix.jnanoid</groupId>
                <artifactId>jnanoid</artifactId>
                <version>${jnanoid.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>
    <modules>
        <module>lambda-framework-enum</module>
        <module>lambda-framework-common</module>
        <module>lambda-framework-rsocket</module>
        <module>lambda-framework-rpc</module>
        <module>lambda-framework-gateway</module>
        <module>lambda-framework-nacos</module>
        <module>lambda-framework-loadbalance</module>
        <module>lambda-framework-httpclient</module>
        <module>lambda-framework-security</module>
        <module>lambda-framework-guid</module>
        <module>lambda-framework-repository</module>
        <module>lambda-framework-qdrant</module>
        <module>lambda-framework-compliance</module>
        <module>lambda-framework-lock</module>
        <module>lambda-framework-mq</module>
    </modules>
    <!-- Remote artifact publishing intentionally disabled. Use mvn install locally. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>27</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.24.0</version>
                <configuration>
                    <generateBackupPoms>false</generateBackupPoms>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
